<?xml version="1.0" encoding="utf-8"?>
<!-- the Relations desktop application's address: scanned from its QR code, pasted or typed, see SelectComputerDialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/p2p_select_message" />

    <Button
        android:id="@+id/button_p2p_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="@string/p2p_scan" />

    <!-- empty for every upload: the address is not remembered -->
    <EditText
        android:id="@+id/edit_p2p_connection_string"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/p2p_address_hint"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:singleLine="true"
        android:typeface="monospace"
        android:textSize="13sp" />
</LinearLayout>
